# ============================================================================
# Quran API with Speech-to-Text - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control!

# ============================================================================
# REQUIRED: OpenAI API Key
# ============================================================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-api-key-here

# ============================================================================
# Database Configuration
# ============================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quran_app

# ============================================================================
# Audio Processing Settings
# ============================================================================

# Sample rate (Hz) - Whisper's optimal rate is 16000
SAMPLE_RATE=16000

# Audio channels (1 = mono, recommended)
CHANNELS=1

# Chunk duration for VAD processing (seconds)
CHUNK_DURATION=0.1

# ============================================================================
# Voice Activity Detection (VAD) Settings
# ============================================================================

# Energy threshold for speech detection (0.01 - 0.20)
# Lower = more sensitive, Higher = less sensitive
# Recommended: 0.03 for normal speech, 0.02 for quiet speech
ENERGY_THRESHOLD=0.03

# Zero Crossing Rate threshold (for advanced VAD)
ZCR_THRESHOLD=0.1

# Minimum frames to consider as speech
MIN_SPEECH_FRAMES=10

# ============================================================================
# Speech Timing Settings
# ============================================================================

# Minimum speech duration to process (seconds)
# Shorter clips are ignored
MIN_SPEECH_DURATION=1.0

# Maximum speech duration per segment (seconds)
# Longer speech is split into segments
MAX_SPEECH_DURATION=30.0

# Silence duration to trigger transcription (seconds)
# How long to wait after speech stops before processing
SILENCE_DURATION=5.0

# ============================================================================
# Audio Preprocessing Settings
# ============================================================================

# Bandpass filter range (Hz)
# Optimized for Arabic speech frequencies
BANDPASS_LOWCUT=80
BANDPASS_HIGHCUT=8000

# Noise gate threshold
# Samples below this amplitude are zeroed
NOISE_GATE_THRESHOLD=0.01

# Pre-emphasis filter coefficient
# Boosts high frequencies for clarity
PRE_EMPHASIS_COEF=0.97

# ============================================================================
# Server Settings (for uvicorn)
# ============================================================================
HOST=0.0.0.0
PORT=8000
RELOAD=true
