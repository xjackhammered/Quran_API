# Quran Recitation App - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=postgresql://postgres:123456@localhost:5432/quran_app

# =============================================================================
# OPENAI API (Required for Speech-to-Text)
# =============================================================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-api-key-here

# =============================================================================
# AUDIO PROCESSING SETTINGS (Optional)
# =============================================================================
# Sample rate for audio processing (default: 16000)
SAMPLE_RATE=16000

# Voice activity detection energy threshold (default: 0.03)
# Lower = more sensitive, Higher = less sensitive
ENERGY_THRESHOLD=0.03

# Minimum speech duration in seconds (default: 1.0)
MIN_SPEECH_DURATION=1.0

# Maximum speech duration in seconds (default: 30.0)
MAX_SPEECH_DURATION=30.0

# Silence duration to trigger transcription (default: 5.0)
SILENCE_DURATION=5.0

# =============================================================================
# SERVER SETTINGS (Optional)
# =============================================================================
# HOST=0.0.0.0
# PORT=8000
# DEBUG=false
